;
; Xabre660 Service Installation
;
[Xabre660.Services]
AddService = SiS315, 0x00000002, SiSGR_Service_Inst, SiSGR_EventLog_Inst
AddService = SiSkp, 0x00000001, SiSkp_Service_Inst

