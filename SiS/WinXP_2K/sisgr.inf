AddReg = DVDOption_AddReg
AddReg = APOption_AddReg
AddReg = 3DOption_AddReg
AddReg = 3D660_AddReg
AddReg = OpenGL_AddReg
AddReg = Util_AddReg
AddReg = DefaultSettings_AddReg
AddReg = TabletPC_AddReg

[Xabre660_SoftwareDeviceSettings]
HKR,, SWKeyIdentifier, %REG_MULTI_SZ%, Xabre
HKR,,SiS.DD.Table,%REG_DWORD%,0x00000000


;
